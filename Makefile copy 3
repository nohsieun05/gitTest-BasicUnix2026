CC=gcc
CFLAGS= -Wall -Iinclude _MMD

SRC= src/main.c src/add.c
OBJ=$(SRC:.c=.o)
DEP=$(SRC:.c=.d)

TARGET=app

all: $(TARGET)

.PHONY: all clean

$(TARGET): $(OBJ)
	$(CC) $(CFLAGS) $^ -o $@

%.o: %.c
	S(CC) $(CFLAGS) $^ -o $@

-include $(DEP)
clean:
	rm -f $(OBJ) $(DEP) $(TARGET)

.PHONY: all clean

app: $(OBJ)
	S(CC) $(CFLAGS) $^ -o $@

%.o: %.c %.h
	$(CC) $(CFLAGS) -c $<